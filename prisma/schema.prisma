generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
//  YOUR EXISTING MODELS (UNCHANGED)
// ==========================================

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  country           String?
  language          String?   @default("en")
  timezone          String?
  defaultMatchView  String?   @default("live")
  dataSaver         Boolean   @default(false)
  autoPlayVideos    Boolean   @default(true)
  showPlayerRatings Boolean   @default(true)
  theme             String?   @default("dark")
  lastLoginAt       DateTime?
  lastLoginIp       String?
  matchReminders    Boolean   @default(true)
  goalAlerts        Boolean   @default(true)
  redCardAlerts     Boolean   @default(true)
  halfTimeScores    Boolean   @default(false)
  fullTimeScores    Boolean   @default(true)
  newsAlerts        Boolean   @default(true)
  transferAlerts    Boolean   @default(false)
  pushEnabled       Boolean   @default(true)
  emailEnabled      Boolean   @default(false)
  quietHoursEnabled Boolean   @default(false)

  accounts      Account[]
  favorites     Favorite[]
  sessions      Session[]
  userXI        UserXI?
  loginActivity LoginActivity[]
  subscription  Subscription?
  blockedUsers  BlockedUser[]   @relation("Blocker")
  blockedBy     BlockedUser[]   @relation("Blocked")
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id        String       @id @default(cuid())
  name      String
  logo      String?
  userId    String
  createdAt DateTime     @default(now())
  itemId    Int
  type      FavoriteType
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@map("FavoriteLeague")
}

enum FavoriteType {
  LEAGUE
  TEAM
  MATCH
  PLAYER
}

model UserXI {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  formation String   @default("4-3-3")
  players   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerIndex {
  id          Int      @id
  name        String
  photo       String?
  nationality String?
  position    String?
  teamId      Int?
  teamName    String?
  teamLogo    String?
  leagueId    Int?
  season      Int
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([teamId])
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  device    String?
  location  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("general")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([userId, read])
}

// ==========================================
//  NEW / EXPANDED MODELS
// ==========================================

model CsvPlayer {
  id        Int      @id @default(autoincrement())
  name      String
  nation    String
  position  String
  squad     String
  comp      String
  age       Float
  born      Int?

  // Standard stats
  mp        Int?
  starts    Int?
  minutes   Int
  n90s      Float?     @map("nineties")
  goals     Int
  assists   Int
  gA        Int?        @map("g_a")
  gPk       Int?        @map("g_pk")
  pk        Int?
  pkatt     Int?
  crdY      Int?
  crdR      Int?

  // Keeper stats
  ga        Int?
  ga90      Float?
  sota      Int?
  saves     Int?
  savePct   Float?     @map("save_pct")
  cs        Int?
  csPct     Float?     @map("cs_pct")

  // Shooting
  shots     Int?
  shotsOnTarget Int?   @map("shots_on_target")
  sotPct    Float?     @map("sot_pct")
  sh90      Float?     @map("sh_90")
  sot90     Float?     @map("sot_90")
  gSh       Float?     @map("g_sh")
  gSot      Float?     @map("g_sot")

  // Playing time
  mnMp      Int?       @map("mn_mp")
  minPct    Float?     @map("min_pct")
  mnStart   Int?       @map("mn_start")
  compl     Int?
  subs      Int?
  mnSub     Int?       @map("mn_sub")
  unSub     Int?
  ppm       Float?
  onG       Int?
  onGa      Int?
  plusMinus Int?       @map("plus_minus")
  plusMinus90 Float?   @map("plus_minus_90")

  // Misc / Defense
  fls       Int?
  fld       Int?
  off       Int?
  crs       Int?
  int       Int?
  tklW      Int?       @map("tkl_w")
  og        Int?

  season    String     @default("2025-2026")

  links     PlayerLink[]

  @@index([name])
  @@index([squad])
  @@index([comp])
  @@map("csv_players")
}

model PlayerLink {
  id              Int       @id @default(autoincrement())
  apiFootballId   Int       @unique @map("api_football_id")
  apiFootballName String    @map("api_football_name")
  
  csvPlayer       CsvPlayer @relation(fields: [csvPlayerId], references: [id])
  csvPlayerId     Int       @map("csv_player_id")
  
  confidence      Int
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("player_links")
}