generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  country           String?
  language          String?   @default("en")
  timezone          String?
  defaultMatchView  String?   @default("live")
  dataSaver         Boolean   @default(false)
  autoPlayVideos    Boolean   @default(true)
  showPlayerRatings Boolean   @default(true)
  theme             String?   @default("dark")
  lastLoginAt       DateTime?
  lastLoginIp       String?

  accounts      Account[]
  favorites     Favorite[]
  sessions      Session[]
  userXI        UserXI?
  loginActivity LoginActivity[]
  subscription  Subscription?
  blockedUsers  BlockedUser[]   @relation("Blocker")
  blockedBy     BlockedUser[]   @relation("Blocked")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id        String       @id @default(cuid())
  name      String
  logo      String?
  userId    String
  createdAt DateTime     @default(now())
  itemId    Int
  type      FavoriteType
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@map("FavoriteLeague")
}

enum FavoriteType {
  LEAGUE
  TEAM
  MATCH
  PLAYER
}

model UserXI {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  formation String   @default("4-3-3")
  players   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerIndex {
  id          Int      @id
  name        String
  photo       String?
  nationality String?
  position    String?
  teamId      Int?
  teamName    String?
  teamLogo    String?
  leagueId    Int?
  season      Int
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([teamId])
}

// New: Google/Facebook-style login history + active sessions view
model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  device    String?
  location  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// New: Stripe-style billing lifecycle
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // "free" | "pro"
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// New: Self-referential block list (only useful if you add comments/mentions/social)
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
